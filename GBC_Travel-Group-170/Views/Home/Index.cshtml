@model IEnumerable<Hotel>

@{
    ViewData["Title"] = "GBC Travel Home Page";
}

<header class="text-center mb-4">
    <h1 class="display-4">Welcome to GBC Travel</h1>
    <p class="lead">Your online portal for booking flights and hotels.</p>
</header>

<hr/>
<nav aria-label="Search Options" class="text-center mb-4">
    <button type="button" class="btn btn-outline-primary me-2">Flights</button>
    <button type="button" class="btn btn-outline-secondary">Hotels</button>
</nav>

<section class="container my-4">
    <nav aria-label="Search Options" class="mb-0">
        <button type="button" class="btn btn-light border border-bottom-0 rounded-bottom-0 px-4 active">Flights</button>
        <button type="button" class="btn btn-light border border-bottom-0 rounded-bottom-0 px-4 text-muted">Hotels</button>
    </nav>

    <section class="border p-4 rounded-end rounded-bottom shadow-sm bg-white mb-5">
        <form method="get" action="/Flights/Search">
            <fieldset class="border-0">
                <legend class="visually-hidden">Flight Search</legend>
                
                <section class="row g-3 align-items-end">
                    <section class="col-md-3">
                        <label for="from-input" class="form-label small text-muted mb-1">From</label>
                        <input type="text" name="from" id="from-input" class="form-control" value="" placeholder="e.g., Toronto (YYZ)"/>
                    </section>
                    
                    <section class="col-md-3">
                        <label for="to-input" class="form-label small text-muted mb-1">To</label>
                        <input type="text" name="to" id="to-input" class="form-control" value="" placeholder="e.g., Vancouver (YVR)"/>
                    </section>
                    
                    <section class="col-md-3">
                        <label for="date-input" class="form-label small text-muted mb-1">Departure Date</label>
                        <input type="date" name="date" id="date-input" class="form-control" value=""/>
                    </section>
                    
                    <section class="col-md-2">
                        <label for="passengers-input" class="form-label small text-muted mb-1">Passengers</label>
                        <select id="passengers-input" name="passengers" class="form-select">
                            <option value="1" selected>1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                            <option value="7">7</option>
                            <option value="8">8</option>
                            <option value="9">9</option>
                            <option value="10">10</option>
                        </select>
                    </section>

                    <section class="col-md-1">
                        <button type="submit" class="btn btn-dark w-100">Search</button>
                    </section>
                </section>
            </fieldset>
        </form>
    </section>
</section>

<hr/>

<h3 class="mb-3">Featured Deals</h3>
<section class="d-flex gap-3">
    @* find the top three best deals from the database and add them here *@
    @foreach (var hotel in Model)
    {
        <figure class="border p-3 rounded shadow-sm flex-fill text-center">
            <img src="" alt="Featured hotel image placeholder" class="img-fluid mb-2"/>
            <h3 class="h5">@hotel.Name</h3>
            <p>$
                <data value="@hotel.PricePerNight">@hotel.PricePerNight.ToString("0.00")</data>
                / night
            </p>
            <a href="/Hotels/Details/@hotel.Id">View Details</a>
        </figure>
    }
</section>