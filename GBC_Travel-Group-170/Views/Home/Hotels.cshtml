
@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Hotels</h2>
// the small mini nav bar to show where you're at at the top of page
<nav>
    @* some loop to see where you are and then display it starting from home page as links *@
    <li><a href="/">Home</a></li>
    <li><a href="/Hotels">Hotels</a></li>
    <li>Hotel Details</li>
</nav>

@* main body  for left and right containers *@
<section>
    //left side
    <section>
        @* main big one showing the first picture *@
        <img src="" alt="Main first hotel image placeholder" />
        <section>
            // need to loop for showing the three subitems, for it to change the main picture to the clicked one
            <img src="" alt="Thumbnail 1" />
            <img src="" alt="Thumbnail 2" />
            <img src="" alt="Thumbnail 3" />
        </section>
    </section>
    
    @* right side now with the hotel information *@
    <section>
        <header>
            <h3> Hotel Name Here</h3>
            <p>Star system rating from datbase</p>
            <p>Location, City, province then dash and then number, and address</p>
        </header>
        
        <section>
            <data value="0"></data>
            <p>Rooms available: <data value="0">0</data></p>
        </section>
        
        <section>
            <h4>Amenities</h4>
            @* loop here to show every amenity in this style from database *@
            <ul>
                <text>Amenity</text>
            </ul>
        </section>
        <textarea></textarea>
        
        <section>
            <a href="/Hotels/Search">&larr; Back to Search Results</a>
            <a href="/Hotels">All Hotels</a>
        </section>
    </section>
</section>