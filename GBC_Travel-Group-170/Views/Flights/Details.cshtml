@model GBC_Travel_Group_170.Models.Flight

@{
    ViewBag.Title = $"Flight {Model.FlightNumber} Details";
    Layout = "_Layout";
}

<h2>Flight Details</h2>

<nav>
    <li><a href="/">Home</a></li>
    <li><a href="/Flights">Flights</a></li>
    <li>@Model.AirlineName @Model.FlightNumber</li>
</nav>

<section>
    <article>
        <section>
            <img src="" alt="Airline logo placeholder"/>
        </section>

        <section class="flight-info">
            <h4>@Model.AirlineName</h4>
            <p>Flight Number: @Model.FlightNumber</p>
        </section>

        <section class="flight-times">
            <p>
                Departure: <time>@Model.DepartureTime.ToString("yyyy-MM-dd HH:mm")</time><br />
                Arrival: <time>@Model.ArrivalTime.ToString("yyyy-MM-dd HH:mm")</time>
            </p>
            <p>Route: @Model.Origin &rarr; @Model.Destination</p>
        </section>
                
        <section class="flight-pricing">
            <data value="@Model.Price">Price: $@Model.Price.ToString("0.00")</data>
        </section>
        
        <section>
            <a href="/Flights">&larr; Back to Flight Search</a>
        </section>
    </article>
</section>